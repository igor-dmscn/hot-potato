# Every value the server reads, with its default. Nothing here is loaded by the
# binary — a dotenv dependency in the process makes production behaviour depend
# on a file that only exists on laptops. Source it in your shell, or let
# compose.yaml's environment do it.
#
# A few have no default and the server refuses to start without them. They are
# marked "required" below, and there is deliberately no HP_ENV=prod to switch
# that on: a profile fails open, so forgetting it in production would reinstate
# every development default silently. What is required is derived from what is
# already set instead.

HP_ADDR=:8080
HP_LOG_LEVEL=info
HP_SHUTDOWN_GRACE=15s

# Empty serves plain HTTP/1.1. Set both and Go negotiates HTTP/2 over ALPN, which
# is the only way a browser gets more than six connections to this origin — the
# sixth tab otherwise starves it, because every tab holds one open for /events.
# Setting one without the other is a deployment that thinks it has TLS, so the
# server refuses to start. `make cert && make run-tls`.
HP_TLS_CERT=
HP_TLS_KEY=

# Required once HP_REDIS_URL is set: two instances both answering to "inst-local"
# break ownership routing, and the client is what follows the 307, so a
# container-internal URL redirects a browser to a host it cannot resolve.
HP_EXTERNAL_URL=http://localhost:8080
HP_INSTANCE_ID=inst-local

# Required, always. A default here compiles the development password into the
# binary, and a typo in production becomes a server quietly running against
# localhost rather than one that refuses to start.
HP_DATABASE_URL=postgres://hotpotato:hotpotato@localhost:5432/hotpotato
HP_SESSION_TTL=168h
HP_LOGIN_MAX_FAILURES=10
HP_LOGIN_FAILURE_WINDOW=15m

# DESIGN §9's policy envelope. Every one of these is a field rather than a
# literal, which is what lets the tests run in milliseconds.
HP_SSE_HEARTBEAT=15s
HP_SSE_RETRY=3s
HP_SSE_WRITE_DEADLINE=10s
HP_STREAM_BUFFER=32
HP_BUS_BUFFER=256
HP_PRESENCE_GRACE=10s

HP_OFFER_TTL=60s
HP_MAX_OUTBOUND=3
HP_MAX_PENDING_INBOUND=10
HP_MAX_PAYLOAD_BYTES=10737418240
HP_MAX_ENTRIES=10000
HP_OFFER_RATE=10
HP_OFFER_RATE_WINDOW=1m
HP_REAP_INTERVAL=5s
HP_TERMINAL_WINDOW=60s

HP_RENDEZVOUS_WAIT=30s
HP_RELAY_WRITE_DEADLINE=30s
HP_RELAY_BUFFER=65536
HP_PROGRESS_INTERVAL=250ms
# 0 makes every interruption terminal, which is phase 5's behaviour.
HP_RESUME_WINDOW=30s

# Leave HP_REDIS_URL empty to run standalone: presence and the Transfer read
# model stay in memory and nothing is shared.
#
# Each broker's address is required when HP_BUS names it — a localhost default
# for a broker is the same trap as one for the database.
HP_BUS=memory
HP_BUS_SUBJECT=hp.events
HP_NATS_URL=nats://localhost:4222
HP_KAFKA_BROKERS=localhost:9092
HP_REDIS_URL=

# Tracing is a no-op with no endpoint: spans are created and dropped.
HP_OTLP_ENDPOINT=
HP_TRACE_SAMPLE=1
HP_READY_TIMEOUT=2s

HP_PRESENCE_TTL=30s
HP_PRESENCE_REFRESH=10s
HP_INSTANCE_TTL=30s
HP_INSTANCE_REFRESH=10s
HP_READ_MODEL_TTL=5m

# Integration suites skip themselves unless these point at something real.
# Separate variables on purpose: a suite that flushes a database should have to
# be aimed deliberately.
HP_TEST_DATABASE_URL=postgres://hotpotato:hotpotato@localhost:5432/hotpotato
HP_TEST_REDIS_URL=redis://localhost:6379/1
HP_TEST_NATS_URL=nats://localhost:4222
HP_TEST_KAFKA_BROKERS=localhost:9092
